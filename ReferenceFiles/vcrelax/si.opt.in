&CONTROL
  calculation    = 'vc-relax',
  prefix         = 'si',
  pseudo_dir     = '/scratch/mate250-fa26/pseudos/',
  outdir         = './Si_out/',
  nstep          = 50,

  etot_conv_thr  = 1.0d-4,
  forc_conv_thr  = 1.0d-4,
/

&SYSTEM
  ibrav          = 0,
  nat            = 2,
  ntyp           = 1,

  ecutwfc        = 28.0,
  ecutrho        = 224.0,
/

&ELECTRONS
  conv_thr       = 1.0d-8,
/

&IONS
  ion_dynamics   = 'bfgs',
/

&CELL
  cell_dynamics  = 'bfgs',
  cell_dofree    = 'all',
  press          = 0.0,
  press_conv_thr = 0.5,
/

ATOMIC_SPECIES
  Si  28.086  Si.pbe-n-kjpaw_psl.1.0.0.UPF

CELL_PARAMETERS {angstrom}
  0.000000000   2.721851186   2.721851186
  2.721851186   0.000000000   2.721851186
  2.721851186   2.721851186   0.000000000

ATOMIC_POSITIONS {crystal}
  Si  0.000000000   0.000000000   0.000000000
  Si  0.250000000   0.250000000   0.250000000

K_POINTS automatic
  8 8 8  0 0 0